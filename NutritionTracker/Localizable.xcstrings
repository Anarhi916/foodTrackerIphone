    "Чтобы сменить язык, закройте и снова откройте приложение.": {
      "localizations": {
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы сменить язык, закройте и снова откройте приложение."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб змінити мову, закрийте та знову відкрийте застосунок."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To change the language, close and reopen the app."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Um die Sprache zu ändern, schließen Sie die App und öffnen Sie sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cambiar el idioma, cierra y vuelve a abrir la app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour changer de langue, fermez puis rouvrez l'application."
