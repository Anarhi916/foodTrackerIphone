          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає підключення до інтернету. Перевірте мережу та спробуйте знову."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No internet connection. Check your network and try again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Internetverbindung. Netzwerk prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin conexión a internet. Compruebe la red e inténtelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune connexion Internet. Vérifiez le réseau et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna connessione a Internet. Controlla la rete e riprova."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem conexão com a internet. Verifique a rede e tente novamente."
          }
        }
      }
    },
    "Превышено время ожидания. Проверьте интернет и попробуйте снова.": {
      "localizations": {
