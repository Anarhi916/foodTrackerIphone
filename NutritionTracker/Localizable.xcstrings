    "Аккаунт и все ваши данные будут удалены безвозвратно. Это действие нельзя отменить." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Konto und alle Daten werden dauerhaft gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account and all your data will be permanently deleted. This action cannot be undone."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu cuenta y todos tus datos se eliminarán permanentemente. Esta acción no se puede deshacer."
