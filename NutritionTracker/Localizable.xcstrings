            "state": "translated",
            "value": "Zeitüberschreitung. Internet prüfen und erneut versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se agotó el tiempo de espera. Compruebe internet e inténtelo de nuevo."
