        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per cambiare lingua, chiudi e riapri l'app."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para mudar o idioma, feche e reabra o app."
